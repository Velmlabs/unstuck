{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@0.0.85", "--cdp-endpoint", "http://127.0.0.1:9222"]
      },
      "unstuck": {
        "type": "local",
        "command": ["npx", "-y", "@velmlabs/unstuck-engine", "--mcp", "--open"],
        "environment": {
          "UNSTUCK_CDP_URL": "http://127.0.0.1:9222"
        }
      }
    }
  }
}
