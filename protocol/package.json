{
  "name": "@velmlabs/unstuck-protocol",
  "version": "0.2.8",
  "description": "Wire protocol shared by the Unstuck engine, viewer and relays (frames, RPC, end-to-end encryption).",
  "keywords": [
    "ai",
    "agent",
    "browser",
    "captcha",
    "human-in-the-loop",
    "playwright",
    "puppeteer",
    "cdp",
    "mcp"
  ],
  "homepage": "https://unstuck.sh/docs",
  "bugs": {
    "url": "https://github.com/velmlabs/unstuck/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/velmlabs/unstuck.git",
    "directory": "protocol"
  },
  "license": "Apache-2.0",
  "author": "Velm Labs",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "export-schemas": "tsx scripts/export-schemas.ts",
    "build:dist": "tsup"
  },
  "dependencies": {
    "@sinclair/typebox": "~0.34.52"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  }
}
