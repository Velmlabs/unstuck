{
  "name": "@velmlabs/unstuck-relay-cloudflare",
  "private": true,
  "version": "0.0.0",
  "description": "Unstuck relay on Cloudflare Workers: one Durable Object per takeover, end-to-end encrypted",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "copy-viewer": "node scripts/copy-viewer.mjs",
    "build": "node scripts/copy-viewer.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/copy-viewer.mjs && vitest run --coverage",
    "dev": "node scripts/copy-viewer.mjs && wrangler dev",
    "deploy": "node scripts/copy-viewer.mjs && wrangler deploy"
  },
  "dependencies": {
    "@velmlabs/unstuck-protocol": "workspace:*",
    "@velmlabs/unstuck-relay-core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@velmlabs/unstuck-core": "workspace:*",
    "@velmlabs/unstuck-viewer": "workspace:*",
    "@vitest/coverage-istanbul": "^4.1.12",
    "vitest": "^4.1.12",
    "wrangler": "^4.161.0"
  }
}
