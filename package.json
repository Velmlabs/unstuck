{
  "name": "unstuck-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm run test:scripts && pnpm -r test && pnpm run test:py",
    "test:scripts": "vitest run --config scripts/vitest.config.ts --coverage",
    "check:runtime": "node scripts/check-runtime-agnostic.mjs protocol/src core/src viewer/src relay-core/src && node scripts/check-edge-graph.mjs sdk-ts/src/edge.ts",
    "test:py": "cd sdk-py && uv run pytest --cov=unstuck -q",
    "e2e:examples": "vitest run --config e2e/vitest.examples.config.ts",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "playwright": "1.63.0",
    "tsup": "9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
